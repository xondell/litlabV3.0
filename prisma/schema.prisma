generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
}

model Book {
  id            String   @id @default(cuid())
  title         String
  author        String
  publishedYear Int?
  coverUrl      String?
  descEn        String?
  descRu        String?
  descRo        String?
  descFr        String?
  plotSummary   String?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  characters    Character[]
  media         Media[]
}

model Character {
  id          String @id @default(cuid())
  name        String
  role        String
  description String
  
  bookId      String
  book        Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Media {
  id          String @id @default(cuid())
  type        String // podcast, video, game, infographic
  title       String
  author      String
  url         String
  duration    String?
  
  bookId      String
  book        Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}
